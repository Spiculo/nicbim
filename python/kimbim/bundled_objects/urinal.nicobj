{
 "format": "kimbim-object/1",
 "id": "urinal",
 "name": {"en": "Urinal", "es": "Mingitorio"},
 "category": "sanitary",
 "ifc": {"IFC4": ["IfcSanitaryTerminalType", "URINAL", null]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 0.36},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.35},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 0.65},
  {"key": "rim", "kind": "length", "label": {"en": "Rim height", "es": "Altura del borde"}, "default": 0.6}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Porcelain"}},
 "parts": [
