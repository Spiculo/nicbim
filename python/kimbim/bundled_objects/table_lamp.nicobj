{
 "format": "kimbim-object/1",
 "id": "table_lamp",
 "name": {"en": "Table lamp", "es": "Lámpara de mesa"},
 "category": "lighting",
 "ifc": {"IFC4": ["IfcLightFixtureType", "USERDEFINED", "LIGHTING"], "IFC2X3": ["IfcLightFixtureType", null, "Lighting"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 0.3},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.3},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 0.5},
  {"key": "shade", "kind": "length", "label": {"en": "Shade height", "es": "Altura de la pantalla"}, "default": 0.2, "min": 0.08, "max": "height / 2"}
 ],
 "materials": {"base": {"label": {"en": "Base material", "es": "Material de la base"}, "default": "Steel"},
               "shade": {"label": {"en": "Shade material", "es": "Material de la pantalla"}, "default": "Glass"}},
 "parts": [
  {"id": "base", "material": "base", "cylinder": {"cx": "width / 2", "cy": "depth / 2", "z": 0, "r": "min(width, depth) * 0.28", "h": 0.02}},
  {"id": "pole", "material": "base", "cylinder": {"cx": "width / 2", "cy": "depth / 2", "z": 0.02, "r": 0.012, "h": "height - shade - 0.02"}},
  {"id": "shade", "material": "shade", "cone": {"cx": "width / 2", "cy": "depth / 2", "z": "height - shade", "r1": "min(width, depth) * 0.4", "r2": "min(width, depth) * 0.28", "h": "shade"}}
 ],
 "symbol": [
  {"circle": {"cx": "width / 2", "cy": "depth / 2", "r": "min(width, depth) * 0.28"}},
  {"circle": {"cx": "width / 2", "cy": "depth / 2", "r": "min(width, depth) * 0.4"}}
 ]
}
