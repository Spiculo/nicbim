 ],
 "materials": {"body": {"label": {"en": "Top and basins", "es": "Tapa y piletas"}, "default": "Porcelain"}, "cabinet": {"label": {"en": "Cabinet", "es": "Mueble"}, "default": "Timber - finish"}},
 "parts": [
