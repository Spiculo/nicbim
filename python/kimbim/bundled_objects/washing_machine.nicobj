{
 "format": "kimbim-object/1",
 "id": "washing_machine",
 "name": {"en": "Washing machine", "es": "Lavarropas"},
 "category": "kitchen",
 "ifc": {"IFC4": ["IfcElectricApplianceType", "WASHINGMACHINE", null]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 0.6},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.6},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 0.85}
 ],
 "materials": {"body": {"label": {"en": "Body", "es": "Cuerpo"}, "default": "Paint - white"}, "glass": {"label": {"en": "Door", "es": "Puerta"}, "default": "Glass"}},
 "parts": [
  {"id": "body", "material": "body", "box": {"dx": "width", "dy": "depth", "dz": "height"}},
  {"id": "door", "material": "glass", "cylinder": {"cx": "width / 2", "cy": "height * 0.55", "r": 0.17, "h": 0.03}, "axes": ["x", "z", "-y"]}
 ],
