{
 "format": "kimbim-object/1",
 "id": "pallet",
 "name": {"en": "Pallet with load", "es": "Pallet con carga"},
 "category": "industrial",
 "ifc": {"IFC4": ["IfcFurnitureType", "USERDEFINED", "PALLET"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "PALLET"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.2},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.8},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.2}
 ],
 "materials": {"body": {"label": {"en": "Load", "es": "Carga"}, "default": "Fabric"}, "frame": {"label": {"en": "Pallet", "es": "Pallet"}, "default": "Timber"}},
 "parts": [
  {"id": "deck", "material": "frame", "box": {"dx": "width", "dy": "depth", "dz": 0.144}},
  {"id": "load", "material": "body", "box": {"x": 0.02, "y": 0.02, "z": 0.144, "dx": "width - 0.04", "dy": "depth - 0.04", "dz": "height - 0.144"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [[0, 0], ["width", "depth"]]}},
  {"line": {"points": [["width", 0], [0, "depth"]]}}
 ]
}
