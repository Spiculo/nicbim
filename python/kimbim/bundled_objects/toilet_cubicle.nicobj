{
 "format": "kimbim-object/1",
 "id": "toilet_cubicle",
 "name": {"en": "Toilet cubicle", "es": "Cabina sanitaria"},
 "category": "sanitary",
 "ifc": {"IFC4": ["IfcFurnitureType", "USERDEFINED", "CUBICLE"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "CUBICLE"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 0.9},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 1.5},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 2.0},
  {"key": "door", "kind": "length", "label": {"en": "Door width", "es": "Ancho de puerta"}, "default": 0.6}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Gypsum board"}},
 "parts": [
  {"id": "side", "material": "body", "repeat": {"count": 2}, "box": {"x": "if(i == 0, 0, width - 0.025)", "z": 0.15, "dx": 0.025, "dy": "depth", "dz": "height - 0.15"}},
  {"id": "front", "material": "body", "box": {"x": 0.025, "z": 0.15, "dx": "width - 0.05 - door", "dy": 0.025, "dz": "height - 0.15"}},
  {"id": "door", "material": "body", "box": {"x": "width - 0.025 - door", "z": 0.15, "dx": "door", "dy": 0.025, "dz": "height - 0.3"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": 0.025, "dy": "depth"}},
  {"rect": {"x": "width - 0.025", "y": 0, "dx": 0.025, "dy": "depth"}},
  {"line": {"points": [[0.025, 0], ["width - 0.025 - door", 0]]}},
  {"arc": {"cx": "width - 0.025 - door", "cy": 0, "r": "door", "a0": 0, "a1": 90}},
  {"line": {"points": [["width - 0.025 - door", 0], ["width - 0.025 - door", "door"]]}}
 ]
}
