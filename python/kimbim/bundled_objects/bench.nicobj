{
 "format": "kimbim-object/1",
 "id": "bench",
 "name": {"en": "Bench", "es": "Banco"},
 "category": "furniture",
 "ifc": {"IFC4": ["IfcFurnitureType", "USERDEFINED", "Bench"], "IFC2X3": ["IfcFurnitureType", null, "Bench"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.8},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.4},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 0.45}
 ],
 "materials": {"body": {"label": {"en": "Seat", "es": "Asiento"}, "default": "Timber"}, "frame": {"label": {"en": "Frame", "es": "Estructura"}, "default": "Steel"}},
 "parts": [
  {"id": "seat", "material": "body", "box": {"z": "height - 0.04", "dx": "width", "dy": "depth", "dz": 0.04}},
  {"id": "support", "material": "frame", "repeat": {"count": 2}, "box": {"x": "if(i == 0, 0.1, width - 0.15)", "dx": 0.05, "dy": "depth", "dz": "height - 0.04"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}}
 ]
}
