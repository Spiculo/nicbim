{
 "format": "kimbim-object/1",
 "id": "car",
 "name": {"en": "Car", "es": "Coche"},
 "category": "site",
 "ifc": {"IFC4": ["IfcBuildingElementProxyType", "USERDEFINED", "CAR"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "CAR"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.8},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 4.5},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.5}
 ],
 "parts": [
  {"id": "wheel", "repeat": {"count": 4}, "axes": ["y", "z", "x"], "cylinder": {"cx": "if(i < 2, depth * 0.18, depth * 0.78)", "cy": 0.32, "z": "if(i % 2 == 0, 0.05, width - 0.25)", "r": 0.32, "h": 0.2}},
  {"id": "body", "rounded_box": {"z": 0.25, "dx": "width", "dy": "depth", "dz": "max(height * 0.55 - 0.25, 0.1)", "r": "min(0.35, width * 0.2)"}},
  {"id": "cabin", "axes": ["y", "z", "x"], "prism": {"points": [["depth * 0.3", "height * 0.55"], ["depth * 0.85", "height * 0.55"], ["depth * 0.75", "height"], ["depth * 0.42", "height"]], "z": 0.1, "h": "width - 0.2"}}
 ],
 "symbol": [
  {"line": {"points": [{"rounded_rect": [0, 0, "width", "depth", 0.3], "n": 3}], "closed": true}},
  {"line": {"points": [[0.1, "depth * 0.3"], ["width - 0.1", "depth * 0.3"]]}},
  {"line": {"points": [[0.1, "depth * 0.42"], ["width - 0.1", "depth * 0.42"]]}},
  {"line": {"points": [[0.1, "depth * 0.75"], ["width - 0.1", "depth * 0.75"]]}},
  {"line": {"points": [[0.1, "depth * 0.85"], ["width - 0.1", "depth * 0.85"]]}}
 ],
 "views": {"front": [{"line": {"points": [{"rounded_rect": [0, 0.25, "width", "height * 0.55 - 0.25", 0.12], "n": 3}], "closed": true}}, {"line": {"points": [[0.12, "height * 0.55"], [0.3, "height"], ["width - 0.3", "height"], ["width - 0.12", "height * 0.55"]]}}, {"rect": {"x": 0.05, "y": 0, "dx": 0.22, "dy": 0.32}}, {"rect": {"x": "width - 0.27", "y": 0, "dx": 0.22, "dy": 0.32}}], "side": [{"line": {"points": [[0.1, 0.3], [0, 0.45], [0.05, "height * 0.55"], ["depth * 0.3", "height * 0.58"], ["depth * 0.42", "height"], ["depth * 0.75", "height"], ["depth * 0.87", "height * 0.58"], ["depth - 0.05", "height * 0.52"], ["depth", 0.45], ["depth - 0.1", 0.3]]}}, {"circle": {"cx": "depth * 0.18", "cy": 0.32, "r": 0.32}}, {"circle": {"cx": "depth * 0.78", "cy": 0.32, "r": 0.32}}, {"line": {"points": [["depth * 0.18 + 0.32", 0.3], ["depth * 0.78 - 0.32", 0.3]]}}, {"line": {"points": [["depth * 0.44", "height * 0.95"], ["depth * 0.44", "height * 0.6"]]}}, {"line": {"points": [["depth * 0.6", "height * 0.98"], ["depth * 0.6", "height * 0.6"]]}}]}
}
