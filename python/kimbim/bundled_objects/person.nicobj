{
 "format": "kimbim-object/1",
 "id": "person",
 "name": {"en": "Person", "es": "Persona"},
 "category": "site",
 "ifc": {"IFC4": ["IfcBuildingElementProxyType", "USERDEFINED", "PERSON"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "PERSON"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 0.5},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.3},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.75}
 ],
 "parts": [
  {"id": "leg", "repeat": {"count": 2}, "rounded_box": {"x": "width * (0.22 + 0.33 * i)", "y": "depth * 0.2", "dx": "width * 0.23", "dy": "depth * 0.6", "dz": "height * 0.47", "r": "width * 0.08"}},
  {"id": "torso", "rounded_box": {"x": "width * 0.12", "y": "depth * 0.1", "z": "height * 0.47", "dx": "width * 0.76", "dy": "depth * 0.8", "dz": "height * 0.35", "r": "depth * 0.35"}},
  {"id": "arm", "repeat": {"count": 2}, "rounded_box": {"x": "if(i == 0, 0, width * 0.88)", "y": "depth * 0.3", "z": "height * 0.45", "dx": "width * 0.12", "dy": "depth * 0.4", "dz": "height * 0.35", "r": "width * 0.05"}},
  {"id": "head", "cylinder": {"cx": "width / 2", "cy": "depth / 2", "z": "height * 0.85", "r": "height * 0.065", "h": "height * 0.15"}}
 ],
 "symbol": [
  {"ellipse": {"cx": "width / 2", "cy": "depth / 2", "rx": "width / 2", "ry": "depth / 2"}},
  {"circle": {"cx": "width / 2", "cy": "depth / 2", "r": "height * 0.065"}}
 ],
 "views": {"front": [{"ellipse": {"cx": "width / 2", "cy": "height * 0.925", "rx": "height * 0.06", "ry": "height * 0.075"}}, {"line": {"points": [["width * 0.38", "height * 0.85"], ["width * 0.12", "height * 0.82"], ["width * 0.08", "height * 0.5"]]}}, {"line": {"points": [["width * 0.62", "height * 0.85"], ["width * 0.88", "height * 0.82"], ["width * 0.92", "height * 0.5"]]}}, {"line": {"points": [["width * 0.22", "height * 0.8"], ["width * 0.26", "height * 0.47"], ["width * 0.3", 0], ["width * 0.46", 0], ["width / 2", "height * 0.45"], ["width * 0.54", 0], ["width * 0.7", 0], ["width * 0.74", "height * 0.47"], ["width * 0.78", "height * 0.8"]]}}]}
}
