{
 "format": "kimbim-object/1",
 "id": "path",
 "name": {"en": "Path", "es": "Sendero"},
 "category": "site",
 "ifc": {"IFC4": ["IfcGeographicElementType", "USERDEFINED", "PATH"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "PATH"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Length", "es": "Longitud"}, "default": 5.0},
  {"key": "depth", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.2},
  {"key": "height", "kind": "length", "label": {"en": "Thickness", "es": "Espesor"}, "default": 0.05}
 ],
 "parts": [
  {"id": "body", "box": {"dx": "width", "dy": "depth", "dz": "height"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [["0", "depth / 2"], ["width", "depth / 2"]]}}
 ]
}
