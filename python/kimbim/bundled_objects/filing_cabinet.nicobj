{
 "format": "kimbim-object/1",
 "id": "filing_cabinet",
 "name": {"en": "Filing cabinet", "es": "Archivador"},
 "category": "office",
 "ifc": {"IFC4": ["IfcFurnitureType", "FILECABINET", null], "IFC2X3": ["IfcFurnitureType", null, "File cabinet"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 0.45},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.6},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.3},
  {"key": "drawers", "kind": "count", "label": {"en": "Drawers", "es": "Cajones"}, "default": 4, "min": 1, "max": 6}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Steel"}},
 "parts": [
  {"id": "body", "material": "body", "box": {"dx": "width", "dy": "depth", "dz": "height"}},
  {"id": "front", "material": "body", "repeat": {"count": "drawers"}, "box": {"x": 0.01, "y": -0.01, "z": "0.02 + (height - 0.04) * i / drawers", "dx": "width - 0.02", "dy": 0.01, "dz": "(height - 0.04) / drawers - 0.01"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [[0, 0.02], ["width", 0.02]]}}
 ]
}
