{
 "format": "kimbim-object/1",
 "id": "library_shelving",
 "name": {"en": "Library shelving", "es": "Estantería de biblioteca"},
 "category": "education",
 "ifc": {"IFC4": ["IfcFurnitureType", "SHELF", null], "IFC2X3": ["IfcFurnitureType", null, "Shelf"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.0},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.6},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.8},
  {"key": "shelves", "kind": "count", "label": {"en": "Shelves per side", "es": "Estantes por lado"}, "default": 5, "min": 2, "max": 8}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Timber - finish"}},
 "parts": [
  {"id": "end", "material": "body", "repeat": {"count": 2}, "box": {"x": "if(i == 0, 0, width - 0.025)", "dx": 0.025, "dy": "depth", "dz": "height"}},
  {"id": "spine", "material": "body", "box": {"x": 0.025, "y": "depth / 2 - 0.01", "dx": "width - 0.05", "dy": 0.02, "dz": "height"}},
  {"id": "shelf", "material": "body", "repeat": {"count": "shelves"}, "box": {"x": 0.025, "z": "0.05 + (height - 0.1) * i / (shelves - 1)", "dx": "width - 0.05", "dy": "depth", "dz": 0.02}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [[0, "depth / 2"], ["width", "depth / 2"]]}}
 ]
}
