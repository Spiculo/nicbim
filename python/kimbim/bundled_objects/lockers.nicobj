{
 "format": "kimbim-object/1",
 "id": "lockers",
 "name": {"en": "Lockers", "es": "Casilleros"},
 "category": "education",
 "ifc": {"IFC4": ["IfcFurnitureType", "USERDEFINED", "LOCKER"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "LOCKER"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.2},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.45},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.8},
  {"key": "columns", "kind": "count", "label": {"en": "Columns", "es": "Columnas"}, "default": 4, "min": 1, "max": 12},
  {"key": "rows", "kind": "count", "label": {"en": "Rows", "es": "Filas"}, "default": 2, "min": 1, "max": 6}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Steel"}},
 "parts": [
  {"id": "body", "material": "body", "box": {"dx": "width", "dy": "depth", "dz": "height"}},
  {"id": "joint_v", "material": "body", "repeat": {"count": "columns - 1"}, "box": {"x": "width * (i + 1) / columns - 0.002", "y": -0.004, "dx": 0.004, "dy": 0.004, "dz": "height"}},
  {"id": "joint_h", "material": "body", "repeat": {"count": "rows - 1"}, "box": {"y": -0.004, "z": "height * (i + 1) / rows - 0.002", "dx": "width", "dy": 0.004, "dz": 0.004}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"repeat": {"count": "columns - 1"}, "line": {"points": [["width * (i + 1) / columns", 0], ["width * (i + 1) / columns", 0.05]]}}
 ]
}
