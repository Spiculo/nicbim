{
 "format": "kimbim-object/1",
 "id": "hedge",
 "name": {"en": "Hedge", "es": "Seto"},
 "category": "site",
 "ifc": {"IFC4": ["IfcGeographicElementType", "USERDEFINED", "HEDGE"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "HEDGE"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Length", "es": "Longitud"}, "default": 2.0},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.6},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.2}
 ],
 "parts": [
  {"id": "body", "box": {"dx": "width", "dy": "depth", "dz": "height"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [["0", "depth / 2"], ["width", "depth / 2"]]}}
 ]
}
