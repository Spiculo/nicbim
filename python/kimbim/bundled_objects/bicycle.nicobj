{
 "format": "kimbim-object/1",
 "id": "bicycle",
 "name": {"en": "Bicycle", "es": "Bicicleta"},
 "category": "site",
 "ifc": {"IFC4": ["IfcBuildingElementProxyType", "USERDEFINED", "BICYCLE"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "BICYCLE"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 0.6},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 1.8},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.0}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Steel"}},
 "parts": [
  {"id": "wheel", "material": "body", "repeat": {"count": 2}, "axes": ["y", "z", "x"], "cylinder": {"cx": "if(i == 0, 0.35, depth - 0.35)", "cy": 0.35, "z": "width / 2 - 0.02", "r": 0.35, "h": 0.04}},
  {"id": "frame", "material": "body", "sweep": {"path": [["width / 2", 0.35, 0.35], ["width / 2", "depth / 2", 0.8], ["width / 2", "depth - 0.35", 0.35]], "r": 0.02}},
  {"id": "bar", "material": "body", "box": {"x": 0.05, "y": "depth - 0.45", "z": "height - 0.03", "dx": "width - 0.1", "dy": 0.03, "dz": 0.03}}
 ],
 "symbol": [
  {"line": {"points": [["width / 2", 0], ["width / 2", "depth"]]}},
  {"line": {"points": [[0.05, "depth - 0.45"], ["width - 0.05", "depth - 0.45"]]}}
 ]
}
