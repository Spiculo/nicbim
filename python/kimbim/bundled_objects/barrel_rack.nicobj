{
 "format": "kimbim-object/1",
 "id": "barrel_rack",
 "name": {"en": "Barrel rack", "es": "Estiba de barricas"},
 "category": "industrial",
 "ifc": {"IFC4": ["IfcFurnitureType", "USERDEFINED", "BARRELRACK"], "IFC2X3": ["IfcBuildingElementProxyType", "USERDEFINED", "BARRELRACK"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Length", "es": "Largo"}, "default": 3.0},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 1.44},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.95}
 ],
 "materials": {"body": {"label": {"en": "Barrels", "es": "Barricas"}, "default": "Timber"}, "frame": {"label": {"en": "Rack", "es": "Estiba"}, "default": "Steel"}},
 "parts": [
  {"id": "barrel", "material": "body", "repeat": {"count": "max(1, floor(width / 0.75)) * max(1, floor(height / 0.72))"}, "axes": ["x", "z", "-y"], "cylinder": {"cx": "0.36 + 0.75 * (i % max(1, floor(width / 0.75)))", "cy": "0.47 + 0.72 * floor(i / max(1, floor(width / 0.75)))", "z": "-depth", "r": 0.35, "h": "depth"}},
  {"id": "rail", "material": "frame", "repeat": {"count": "2 * max(1, floor(height / 0.72))"}, "box": {"y": "if(i % 2 == 0, 0.15, depth - 0.2)", "z": "0.72 * floor(i / 2)", "dx": "width", "dy": 0.05, "dz": 0.12}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"repeat": {"count": "max(1, floor(width / 0.75)) - 1"}, "line": {"points": [["0.75 * (i + 1)", 0], ["0.75 * (i + 1)", "depth"]]}}
 ]
}
