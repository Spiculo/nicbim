{
 "format": "kimbim-object/1",
 "id": "pallet_racking",
 "name": {"en": "Pallet racking", "es": "Estantería industrial"},
 "category": "industrial",
 "ifc": {"IFC4": ["IfcFurnitureType", "SHELF", null], "IFC2X3": ["IfcFurnitureType", null, "Racking"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 2.7},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 1.1},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 4.5},
  {"key": "beams", "kind": "count", "label": {"en": "Beam levels", "es": "Niveles de vigas"}, "default": 3, "min": 1, "max": 8}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Steel"}},
 "parts": [
  {"id": "upright", "material": "body", "repeat": {"count": 4}, "box": {"x": "if(i % 2 == 0, 0, width - 0.09)", "y": "if(i < 2, 0, depth - 0.09)", "dx": 0.09, "dy": 0.09, "dz": "height"}},
  {"id": "beam", "material": "body", "repeat": {"count": "2 * beams"}, "box": {"y": "if(i % 2 == 0, 0, depth - 0.05)", "z": "height * (floor(i / 2) + 1) / (beams + 1)", "dx": "width", "dy": 0.05, "dz": 0.12}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [[0, 0], ["width", "depth"]]}}
 ]
}
